# --------------------------------------------
# General
# --------------------------------------------
NODE_ENV=development

# --------------------------------------------
# API
# --------------------------------------------
APP_PORT=4000
CORS_ORIGIN=http://localhost:3000

# --------------------------------------------
# Auth
# --------------------------------------------
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars-long
JWT_TTL_SECONDS=28800

# --------------------------------------------
# Database
# --------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=property_management
DB_USER=postgres
DB_PASSWORD=postgres

# --------------------------------------------
# AI agent
# --------------------------------------------
# Base URL of the ai-agent service (server-side only).
AI_AGENT_URL=http://localhost:8080

# --------------------------------------------
# WhatsApp
# --------------------------------------------
# Force the WhatsApp integration off (local test mode), overriding Settings.
# Leave unset to follow the Settings.whatsapp_enabled toggle.
WHATSAPP_API_ENABLED=false
