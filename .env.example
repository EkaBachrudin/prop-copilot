# --------------------------------------------
# Docker Compose configuration
# Copy to .env and adjust as needed.
# --------------------------------------------

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=property_management
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin

# Published ports
APP_PORT=4000
FE_PORT=3000
AGENT_PORT=5000

# --------------------------------------------
# AI agent / WhatsApp
# --------------------------------------------
# OpenAI credentials live in ai-agent/.env (consumed by the ai-agent container).

# Force WhatsApp Cloud API off for local testing (overrides Settings).
# Set to true once real Meta credentials are configured in WhatsApp Settings.
WHATSAPP_API_ENABLED=false
